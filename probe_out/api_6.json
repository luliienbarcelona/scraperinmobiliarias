monapart.felix-resized/800/agent_avatar/Paz-Malet-resenas-jpg-6763108141c38.jpg", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_avatar/Paz-Malet-resenas-jpg-6763108141c38.jpg", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_avatar/Paz-Malet-resenas-jpg-6763108141c38.jpg"}}, "certifications": [{"id": "AICAT", "title": "AICAT (Agent Immobiliari de Catalunya)", "alt": {"es": "Logo de AICAT, Agente Inmobiliario de Catalunya", "ca": "Logo d'AICAT, Agent. Immobiliari de Catalunya", "en": "Logo of AICAT, Real Estate Agent of Catalonia"}, "link": "http://agenciahabitatge.gencat.cat/wps/portal/!ut/p/z1/04_iUlDgAgL9CCADyIQSuGj9qLzEssz0xJLM_LzEHP0I_cgos3iLAEt3DwsTIx-DIC8TA0dTTxd3TwsTYwMDE30vsEaofoQxqGwwoR-F36QIqDZU_eiUfmRmVmFhlKN-VHJ-XklqRYl-RGJGcnKiqkF5apKqQXFqUVlqZrGqQVFipn5BdlQkAPrk5to!/", "schema": {"name": "AICAT", "prop": "memberOf", "content": "AICAT"}}, {"id": "API", "title": "API (Agente de la Propiedad Inmobiliaria)", "alt": {"es": "Logo de API, Agente de la Propiedad Inmobiliaria", "ca": "Logo d'API, Agent de la Propietat Immobiliària", "en": "Logo of API, Real Estate Agent"}, "link": "https://www.api.cat", "schema": {"name": "API", "prop": "award", "content": "Agente de la Propiedad Inmobiliaria Certificado"}}], "googleValorationLink": "https://g.co/kgs/7SfA4YW", "googleValorationImage": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_googleValorationImage/Topo-Google-5-png-6862cde30ad37.png", "reviews": [{"es-ES": {"title": "Cris Guerra Cusí", "content": "¡Súper contentos! Vendimos nuestro piso con Paz y consiguió venderlo en muy poco tiempo. Recibimos un trato inmejorable y con todas las facilidades."}, "ca-ES": {"title": "Cris Guerra Cusí", "content": "Super contents! Vam vendre el nostre pis amb Pau i va aconseguir vendre'l en molt poc temps. Rebem un tracte immillorable i amb totes les facilitats."}, "en-US": {"title": "Cris Guerra Cusí", "content": "Super happy! We sold our apartment with Paz and she managed to sell it in a very short time. We received unbeatable treatment and all the facilities."}}, {"es-ES": {"title": "José Álvaro Estrada", "content": "Todo ha sido excelente con la ayuda de Paz. Me ha dado la información necesaria, ha ayudado y siempre ha estado disponible para cualquier duda. Una gran profesional. ¡Muy recomendable!"}, "ca-ES": {"title": "José Álvaro Estrada", "content": "Tot ha estat excel·lent amb l'ajuda de Pau. M'ha donat la informació necessària, ha ajudat i sempre ha estat disponible per a qualsevol dubte. Una gran professional. Molt recomanable!"}, "en-US": {"title": "José Álvaro Estrada", "content": "Everything has been excellent with Paz's help. She has given me the necessary information, she has helped and she has always been available for any questions. A great professional. Highly recommended!"}}, {"es-ES": {"title": "Luis Font", "content": "Excelente servicio, muy atenta Paz y muy resolutiva. Captó muy rápido lo que buscábamos y nos ayudó en la negociación y toda la gestión de papeles. "}, "ca-ES": {"title": "Luis Font", "content": "Excel·lent servei, molt atenta Pau i molt resolutiva. Va captar molt ràpid el que buscàvem i ens va ajudar en la negociació i tota la gestió de papers."}, "en-US": {"title": "Luis Font", "content": "Excellent service, Paz was very attentive and very decisive. She quickly understood what we were looking for and helped us with the negotiation and all the paperwork."}}, {"es-ES": {"title": "Elisabet Rius", "content": "He estado meses buscando piso de compra en Barcelona y la experiencia, el trato, la manera de estar durante el proceso de compra por parte de Paz es distinta a la de otras inmobiliarias. Muy cercana y resolutiva."}, "ca-ES": {"title": "Elisabet Rius", "content": "He estat mesos buscant pis de compra a Barcelona i l'experiència, el tracte, la manera d'estar durant el procés de compra per part de Paz és diferent de les altres immobiliàries. Molt propera i resolutiva."}, "en-US": {"title": "Elizabeth Rius", "content": "I have been looking for a flat to buy in Barcelona for months and the experience, the treatment, the way of being during the purchase process by Paz is different from that of other real estate agencies. Very friendly and decisive."}}, {"es-ES": {"title": "Paula Hernández", "content": "Ha sido una maravilla contar con los servicios de Paz. Es encantadora, sumamente profesional y ha hecho del proceso de compra un trámite fácil y eficiente, acompañándome durante todo el proceso y prestando especial atención a los detalles. ¡Experiencia más que satisfactoria y 100% recomendable!"}, "ca-ES": {"title": "Paula Hernández", "content": "Ha estat una meravella comptar amb els serveis de Pau. És encantadora, summament professional i ha fet del procés de compra un tràmit fàcil i eficient, acompanyant-me durant tot el procés i prestant especial atenció als detalls. Experiència més que satisfactòria i 100% recomanable!"}, "en-US": {"title": "Paula Hernández", "content": "It has been wonderful to have Paz's services. She is charming, extremely professional and has made the purchase process easy and efficient, accompanying me throughout the entire process and paying special attention to the details. A more than satisfactory experience and 100% recommendable!"}}], "videos": [], "slogan": {"es-ES": "\"Cada mañana me levanto queriendo ser parte de nuevas historias que, en definitiva, también serán parte de la mía.\"", "ca-ES": "\"Cada matí m'aixeco volent ser part de noves històries que, en definitiva, també seran part de la meva.\"", "en-US": "\"Every morning I wake up wanting to be part of new stories that, ultimately, will also be part of mine.\""}, "aboutMe": {"es-ES": "Licenciada en psicología, publicidad y RRPP con un máster en marketing y comunicación, llegué al sector inmobiliario hace casi tres años, por casualidad. Desde el primer día, descubrí que el verdadero valor de esta profesión reside en saber cuidar y entender al cliente. Sin experiencia previa, me enfoqué en acompañar a cada persona en el delicado proceso de vender o alquilar su vivienda, prestando atención a sus necesidades y brindando un apoyo genuino en cada paso. Esa cercanía y compromiso han sido clave para construir una sólida cartera de clientes que confían en mí. \n\nEn situaciones complejas como herencias o divorcios, he ayudado no sólo a gestionar la operación, sino a ofrecer un acompañamiento real y humano, escuchando, consolando o haciendo cajas si ha sido preciso. Creo que la combinación de mis estudios y habilidades me permiten ejercer esta profesión de manera distinta. \n\nFuera del trabajo, soy una apasionada del deporte —ya sea correr, el senderismo o deportes de raqueta— y siempre encuentro alguna excusa para celebrar la vida con familia y amigos. Mi película favorita es \"La vida es bella\", porque creo que la felicidad está en cómo vemos las cosas, algo que aplico tanto en mi vida personal como en mi día a día con cada cliente.", "ca-ES": "Llicenciada en psicologia, publicitat i RRPP amb un màster en màrqueting i comunicació, vaig arribar al sector immobiliari fa gairebé tres anys, per casualitat. Des del primer dia vaig descobrir que el veritable valor d'aquesta professió és saber cuidar i entendre el client. Sense experiència prèvia, vaig enfocar-me a acompanyar cada persona en el delicat procés de vendre o llogar el seu habitatge, parant atenció a les seves necessitats i brindant un suport genuí a cada pas. Aquesta proximitat i compromís han estat clau per construir una cartera sòlida de clients que confien en mi. \n\nEn situacions complexes com herències o divorcis, he ajudat no només a gestionar l'operació, sinó també a oferir un acompanyament real i humà, escoltant, consolant o fent caixes si ha calgut. Crec que la combinació dels meus estudis i habilitats em permeten exercir aquesta professió de manera diferent. \n\nFora de la feina, sóc una apassionada de l'esport —ja sigui córrer, el senderisme o els esports de raqueta— i sempre trobo alguna excusa per celebrar la vida amb família i amics. La meva pel·lícula favorita és \"La vida és bella\", perquè crec que la felicitat està en com veiem les coses, cosa que aplico tant a la meva vida personal com al meu dia a dia amb cada client.", "en-US": "With a degree in Psychology, Advertising and PR with a Master's Degree in Marketing and Communication, I came to the real estate sector almost three years ago, by chance. From day one, I discovered that the true value of this profession lies in knowing how to care for and understand the client. Without previous experience, I focused on accompanying each person in the delicate process of selling or renting their home, paying attention to their needs and providing genuine support at every step. That closeness and commitment have been key to building a solid portfolio of clients who trust me. \n\nIn complex situations such as inheritances or divorces, I have helped not only manage the operation, but also offer real and human support, listening, comforting or cashing out if necessary. I believe that the combination of my studies and skills allow me to practice this profession in a different way. \n\nOutside of work, I am passionate about sports—whether it be running, hiking or racquet sports—and I always find an excuse to celebrate life with family and friends. My favorite movie is \"Life is Beautiful,\" because I believe that happiness lies in how we see things, something that I apply both in my personal life and in my day-to-day work with each client."}, "training": {"es-ES": "API #A14645 | AICAT | Psicología | Publicidad y Relaciones Públicas | Marketing y Comunicación", "ca-ES": "API #A14645| AICAT | Psicologia | Publicitat i Relacions Públiques | Màrqueting i Comunicació", "en-US": "API #A14645 | AICAT | Psychology | Advertising and Public Relations | Marketing and Communication"}, "experience": {"es-ES": "+4 años en el sector inmobiliario", "ca-ES": "+4 anys al sector immobiliari", "en-US": "+4 years in the real estate sector"}, "ourSales": {"es-ES": "+51 ventas | +6 alquileres", "ca-ES": "+51 vendes | +6 lloguers", "en-US": "+51 sales | +6 rentals"}, "services": {"es-ES": "Venta | Alquiler | Personal Shopping", "ca-ES": "Venda | Lloguer | Personal Shopping", "en-US": "Sale | Rent | Personal Shopping"}, "zones": {"es-ES": "Barcelona | Costa Brava | La Cerdanya | Baleares", "ca-ES": "Barcelona | Costa Brava | La Cerdanya | Balears", "en-US": "Barcelona | Costa Brava | La Cerdanya | Balearics"}, "agency": {"commercialBrand": "Paz Malet", "manager": false, "independent": true, "externalAgencyLogo": null, "logo": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agency_logo/CoBrand-Paz-Malet-negativo-jpg-673345d092f88.jpg", "slug": "paz-malet", "reviews": []}}}, {"reference": "AP0007-6826", "slug": "atico-en-alquiler-en-sagrada-familia-con-3-habitaciones-y-terraza-barcelona", "type": "rent", "status": "reserved", "estateType": "flat", "address": {"visibility": null, "point": null, "streetType": "Carrer", "streetName": "Rosselló", "streetNumber": "418", "province": "Barcelona", "provinceSlug": "barcelona", "town": "Barcelona", "zone": "Sagrada Família", "zoneGroup": "Eixample"}, "price": 1253.92, "externalResources": [{"url": "https://youtu.be/e9oiNzlg0Rc", "description": "AP0007-6826", "type": "video"}], "createdAt": "2026-09-30 10:54:46", "updatedAt": "2026-10-05 21:02:53", "cee": {"energyCertificateType": "completed", "energyCertificateRating": "G", "energyCertificateEmissionsRating": "F", "energyCertificateValue": 305, "energyCertificateEmissionsValue": 54}, "propertyType": "flat", "features": ["terrace", "elevator"], "areaConstructed": 72, "areaUsable": 53.5, "areaPlot": null, "orientationNorth": null, "orientationSouth": null, "orientationEast": null, "orientationWest": true, "conservation": "good", "rooms": 3, "furnished": true, "floorsBuilding": 8, "bathroomNumber": 1, "conditionedAir": true, "penthouse": true, "emotionalTitle": {"es-ES": "Te cambia la vida", "ca-ES": "Et canvia la vida", "en-US": "It changes your life"}, "emotionalDescription": {"es-ES": "Puede parecer exagerado, pero una terraza como esta te cambia la vida. En apariencia es sencilla: unas plantitas, un toldo, una mesa, unas sillas y algo de espacio extra para poner una tumbona o sacar la esterilla para hacer el saludo al sol (literal). Pero este espacio es capaz de levantarte el ánimo cada mañana, por muy temprano y por muy lunes que sea; hace de las comidas un acontecimiento, aunque comas a solas; y hace que pases de vivir en un piso a un hogar.", "ca-ES": "Pot semblar exagerat, però una terrassa com aquesta canvia la vida. En aparença és senzilla: unes plantetes, un tendal, una taula, unes cadires i una mica d'espai extra per posar una gandula o treure l'estoreta per fer la salutació al sol (literal). Però aquest espai és capaç d'aixecar-te l'ànim cada matí, molt aviat i molt dilluns que sigui; fa dels àpats un esdeveniment, encara que mengis tot sol; i fa que passis de viure en un pis a una llar.", "en-US": "It might sound exaggerated, but a terrace like this is life-changing. It looks simple: a few plants, an awning, a table, some chairs, and a bit of extra space for a sun lounger or a yoga mat for a sun salutation (literally). But this space can lift your spirits every morning, no matter how early or how Monday-ish it is; it makes mealtimes a special occasion, even if you're eating alone; and it transforms living in an apartment into a home."}, "description": {"es-ES": "Ático en alquiler en Sagrada Família con 3 habitaciones y terraza, Barcelona", "ca-ES": "Àtic de lloguer a Sagrada Família amb 3 habitacions i terrassa, Barcelona", "en-US": "Penthouse for rent in Sagrada Família with 3 bedrooms and terrace, Barcelona"}, "highlights": {"es-ES": "Ático en alquiler en Sagrada Família, Barcelona, con 3 habitaciones y terraza.\nSituado en la 8ª planta de una finca del 1956 con ascensor en la calle Rosselló. \nDispone de 3 habitaciones (una doble exterior y dos individuales), 1 baño completo, salón-comedor con salida a terraza, cocina equipada y zona de lavado.\nCuenta con armarios en el recibidor y dos de las habitaciones. Muebles auxiliares en el resto del piso. La distribución es funcional, con estancias luminosas.\nSuelos de parquet, carpintería exterior de aluminio y las persianas manuales.\nTiene aire acondicionado por splits (frío y calor).\nSe alquila semiamueblado, en buen estado.", "ca-ES": "Àtic de lloguer a Sagrada Família, Barcelona, amb 3 habitacions i terrassa.\nSituat a la 8a planta d'una finca del 1956 amb ascensor al carrer Rosselló.\nDisposa de 3 habitacions (una doble exterior i dues individuals), 1 bany complet, saló-menjador amb sortida a terrassa, cuina equipada i zona de rentat.\nCompta amb armaris al rebedor i dues de les habitacions. Mobles auxiliars a la resta del pis. La distribució és funcional, amb estades lluminoses.\nTerres de parquet, fusteria exterior dalumini i les persianes manuals.\nTé aire condicionat per splits (fred i calor).\nEs lloga semimoblat, en bon estat.", "en-US": "Penthouse for rent in Sagrada Família, Barcelona, with 3 bedrooms and terrace.\nLocated on the 8th floor of a 1956 building with an elevator on Rosselló Street.\nIt has 3 bedrooms (one double exterior and two singles), 1 full bathroom, living-dining room with access to a terrace, equipped kitchen and laundry area.\nIt has wardrobes in the entrance hall and two of the bedrooms. Additional furniture is provided throughout the rest of the apartment. The layout is functional, with bright rooms.\nParquet floors, aluminum exterior carpentry and manual blinds.\nIt has split-system air conditioning (heating and cooling).\nSemi-furnished rental, in good condition."}, "isSpecialFor": {"es-ES": "Destaca por su terraza con gran entrada de luz natural, y su distribución funcional.\nUna ubicación privilegiada y muy bien comunicada.\nCon vistas a la Avinguda Gaudí y cerca de todo tipo de servicios.", "ca-ES": "Destaca per la terrassa amb gran entrada de llum natural i la seva distribució funcional.\nUna ubicació privilegiada i molt ben comunicada.\nAmb vista a l'Avinguda Gaudí ia prop de tot tipus de serveis.", "en-US": "It stands out for its terrace with ample natural light, and its functional layout.\nA prime location with excellent transport links.\nOverlooking Avinguda Gaudí and close to all kinds of services."}, "conditions": {"es-ES": "CONDICIONES ECONÓMICAS Y LEGALES\nHonorarios de agencia a cargo de la propiedad.\nPropiedad considerada no gran tenedor.\nLa renta incluye los gastos repercutibles de IBI.\nEl Sistema Estatal de Índices de Precios del Alquiler de Vivienda establece una renta de referencia entre 804,26 y 1.032,21 € mensuales.\nMensualidad del contrato anterior: 1.161 € mensuales, actualizada a 1.253,92 € mensuales.\nActualización anual conforme al IRAV.\nGarantías: 1 mes de fianza y 1 mes de garantía adicional.\nInformación legal (Art. 20.1 TRLDCU):\nEl inquilino deberá abonar:\nImpuestos: ITP sobre garantías (1% sobre avales o depósitos que excedan el mes de fianza obligatoria), a cargo del inquilino.\nGarantías: Fianza legal y garantía adicional.\nCONDICIONES DEL CONTRATO\nContrato de 1 año prorrogable a 5 años.\nDisponibilidad inmediata.\nREQUISITOS DEL INQUILINO\nImprescindible acreditar solvencia económica (nóminas, avales o similar en caso de autónomos).\nEn caso de no disponer de ingresos en España, se solicitará información adicional y garantías complementarias.\nCONDICIONES DE USO DE LA VIVIENDA\nVivienda no apta para compartir con amig@s o compañer@s.\nNo se aceptan mascotas.\nINFORMACIÓN ADICIONAL\nSe alquila con los electrodomésticos que aparecen en las imágenes.\nReferencia Certificado Energético: 64156TW9P", "ca-ES": "CONDICIONS ECONÒMIQUES I LEGALS\nHonoraris dagència a càrrec de la propietat.\nPropietat considerada no gran forquilla.\nLa renda inclou les despeses repercutibles de IBI.\nEl sistema estatal d'índexs de preus del lloguer d'habitatge estableix una renda de referència entre 804,26 i 1.032,21 € mensuals.\nMensualitat del contracte anterior: 1.161 € mensuals, actualitzada a 1.253,92 € mensuals.\nActualització anual d'acord amb l'IRAV.\nGaranties: 1 mes de fiança i 1 mes de garantia addicional.\nInformació legal (Art. 20.1 TRLDCU):\nL'inquilí haurà d'abonar:\nImpostos: ITP sobre garanties (1% sobre avals o dipòsits que excedeixin el mes de fiança obligatòria), a càrrec de l'inquilí.\nGaranties: Fiança legal i garantia addicional.\nCONDICIONS DEL CONTRACTE\nContracte de 1 any prorrogable a 5 anys.\nDisponibilitat immediata.\nREQUISITS DE L'INQUILI\nImprescindible acreditar solvència econòmica (nòmines, avals o semblant en cas d'autònoms).\nEn cas de no disposar dingressos a Espanya, se sol·licitarà informació addicional i garanties complementàries.\nCONDICIONS D'ÚS DE L'HABITATGE\nHabitatge no apte per compartir amb amics o companyes.\nNo s'accepten mascotes.\nINFORMACIÓ ADDICIONAL\nEs lloga amb els electrodomèstics que apareixen a les imatges.\nReferència Certificat Energètic: 64156TW9P", "en-US": "ECONOMIC AND LEGAL CONDITIONS\nAgency fees to be paid by the property owner.\nProperty considered not to be a large holding company.\nThe rent includes the reimbursable expenses of IBI (Property Tax).\nThe State Housing Rental Price Index System establishes a reference rent between €804.26 and €1,032.21 per month.\nMonthly payment of the previous contract: €1,161 per month, updated to €1,253.92 per month.\nAnnual update in accordance with IRAV.\nGuarantees: 1 month deposit and 1 month additional guarantee.\nLegal information (Art. 20.1 TRLDCU):\nThe tenant must pay:\nTaxes: ITP on guarantees (1% on guarantees or deposits that exceed the mandatory security deposit month), payable by the tenant.\nGuarantees: Legal bond and additional guarantee.\nCONTRACT CONDITIONS\n1 year contract renewable for 5 years.\nImmediate availability.\nTENANT REQUIREMENTS\nIt is essential to prove financial solvency (pay stubs, guarantees or similar in the case of self-employed individuals).\nIf you do not have income in Spain, additional information and supplementary guarantees will be requested.\nCONDITIONS OF USE OF THE HOUSING\nHousing not suitable for sharing with friends or colleagues.\nNo pets allowed.\nADDITIONAL INFORMATION\nIt is rented with the appliances shown in the pictures.\nEnergy Certificate Reference: 64156TW9P"}, "metaTitle": {"es-ES": "Ático en alquiler en Barcelona con terraza y ascensor", "ca-ES": "Lloguer d'àtic a Barcelona amb terrassa i ascensor", "en-US": "Top-floor apartment for rent in Barcelona with terrace"}, "metaDescription": {"es-ES": "Ático en alquiler en Barcelona de 72 m² construidos, 3 habitaciones, terraza, ascensor y aire acondicionado con bomba de calor. Parcialmente amueblado.", "ca-ES": "Àtic en lloguer a Barcelona de 72 m² construïts, 3 habitacions, terrassa, ascensor i aire condicionat amb bomba de calor. Parcialment moblat.", "en-US": "Top-floor apartment for rent in Barcelona with 72 m² built, 3 bedrooms, terrace, elevator and split A/C with heat pump. Partially furnished."}, "urlSlug": {"es-ES": "alquiler-piso-barcelona-terraza-3-habitaciones", "ca-ES": "lloguer-pis-barcelona-terrassa-3-habitacions", "en-US": "rent-apartment-barcelona-terrace-3-bedrooms"}, "basic": {"es-ES": null, "ca-ES": null, "en-US": null}, "agent": {"fullName": "Anna Mª Palomas", "commercialBrand": null, "email": "annam.palomas@monapart.com", "telNumber": "+34606321128", "telFullNumber": "+34606321128", "languages": ["Español", "Català"], "socialNetworks": {"instagram": "https://www.instagram.com/annam.palomas/", "linkedIn": "https://www.linkedin.com/in/anna-m%C2%AA-palomas-pons-78236b14b/", "facebook": "https://www.facebook.com/annam.palomas"}, "slug": "annam-palomas", "display": true, "avatar": {"url": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "dimensions": {"160": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/160/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "420": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/420/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "600": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/600/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "800": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/800/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg"}}, "highlightedPhoto": {"url": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "dimensions": {"160": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/160/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "420": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/420/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "600": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/600/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "800": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/800/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_highlight/Diseno-sin-titulo-4-png-62dd9eefd3162.png"}}, "relatedImage": {"url": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "dimensions": {"160": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/160/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "420": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/420/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "600": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/600/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "800": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/800/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_avatar/AMP-7050-jpeg-62d7e767879fd.jpg"}}, "certifications": null, "googleValorationLink": null, "googleValorationImage": null, "reviews": [{"es-ES": {"title": "Alejandra Iglesias", "content": "Muy buena experiencia en la compra de un piso para inversión. Anna Mª Palomas un 10 en todo, profesional, transparente y humana. Estoy contentísima con la inversión y con el trato."}, "ca-ES": {"title": "Alejandra Iglesias", "content": "Molt bona experiència en la compra dun pis per inversió. Anna Mª Palomas un 10 en tot, professional, transparent i humana. Estic contentíssima amb la inversió i amb el tracte."}, "en-US": {"title": "Alejandra Iglesias", "content": "Very good experience in the purchase of a flat for investment. Anna Mª Palomas is a 10 in everything, professional, transparent and human. I am very happy with the investment and the treatment."}}, {"es-ES": {"title": "Miguel Ángel Domínguez", "content": "Ha sido un placer trabajar con esta inmobiliaria, sobre todo con Anna Mª que en todo momento estuvo asesorando para que la venta se realizara lo antes posible y en condiciones satisfactorias."}, "ca-ES": {"title": "Miguel Ángel Domínguez", "content": "Ha estat un plaer treballar amb aquesta immobiliària, sobretot amb Anna Mª que en tot moment va estar assessorant perquè la venda es fes com més aviat millor i en condicions satisfactòries."}, "en-US": {"title": "Miguel Ángel Domínguez", "content": "It has been a pleasure to work with this Real Estate agency, especially with Anna Mª who was advising at all times so that the sale was carried out as soon as possible and under satisfactory conditions."}}, {"es-ES": {"title": "Begoña Harper", "content": "Super contentos con la atención y gestión recibidas por parte de Anna Mª, muy profesional y atenta con los clientes. De hecho ya habíamos trabajado con ella anteriormente y lo seguiremos haciendo. Le doy 5 estrellas porque no hay más, ¡pero es de 10!"}, "ca-ES": {"title": "Begoña Harper", "content": "Super contents amb l'atenció i la gestió rebudes per part d'Anna Mª, molt professional i atenta amb els clients. De fet ja havíem treballat amb ella anteriorment i ho continuarem fent. Li dono 5 estrelles perquè no n'hi ha més, però és de 10!"}, "en-US": {"title": "Begoña Harper", "content": "We are very happy with the attention and management received from Anna Mª, very professional and attentive to customers. In fact, we had already worked with her before and we will continue to do so. I give her 5 stars because there are no more, but it is a 10!"}}, {"es-ES": {"title": "Maribel Arrabal", "content": "Anna Mª eres una maravilla. Estamos encantados de tu dedicación y profesionalidad durante todo el proceso de compraventa (que ha sido más largo de lo que esperábamos, desgraciadamente). Muchísimas gracias por todo,  especialmente por el cariño con el que nos has tratado. Si nos vuelve a hacer falta no dudes que nos pondremos en contacto contigo."}, "ca-ES": {"title": "Maribel Arrabal", "content": "Anna Mª ets una meravella. Estem encantats de la teva dedicació i professionalitat durant tot el procés de compravenda (que ha estat més llarg del que esperàvem, malauradament). Moltíssimes gràcies per tot, especialment per l'afecte amb què ens has tractat. Si ens torna a fer falta no dubtis que ens posarem en contacte amb tu."}, "en-US": {"title": "Maribel Arrabal", "content": "Anna Mª, you are wonderful. We are delighted with your dedication and professionalism throughout the entire buying and selling process (which has been longer than we expected, unfortunately). Thank you very much for everything, especially for the kindness with which you have treated us. If we need you again, do not hesitate to contact you."}}, {"es-ES": {"title": "Diego Arrabal", "content": "Hemos tenido la suerte de que Anna Mª se haya ocupado de la venta de un piso de un familiar. ¡Da gusto tratar con gente tan profesional! Altamente recomendable. No dudéis en acudir a ella para cualquier compra o venta."}, "ca-ES": {"title": "Diego Arrabal", "content": "Hem tingut la sort que l'Anna Mª s'hagi ocupat de la venda d'un pis d'un familiar. Dóna gust tractar amb gent tan professional! Altament recomanable. No dubteu a acudir-hi per a qualsevol compra o venda."}, "en-US": {"title": "Diego Arrabal", "content": "We have been lucky enough to have Anna Mª take care of the sale of a flat belonging to a family member. It is a pleasure to deal with such professional people! Highly recommended. Do not hesitate to contact her for any purchase or sale."}}, {"es-ES": {"title": "Luis Aguilar", "content": "Espectacular inmobiliaria. Muy profesionales, se entregan al 100x100% a sus clientes y he tenido la grandísima oportunidad de estar asesorado por Anna Mª Palomas, que me ha vendido dos propiedades y jamás he tenido ningún problema. Una grandísima profesional, rápida en vender y muy seria en temas de documentaciones. Sin duda repetiré."}, "ca-ES": {"title": "Luis Aguilar", "content": "Espectacular immobiliària. Molt professionals, es lliuren al 100x100% als seus clients i he tingut la grandíssima oportunitat d'estar assessorat per Anna Mª Palomas, que m'ha venut dues propietats i no he tingut mai cap problema. Una grandíssima professional, ràpida a vendre i molt seriosa en temes de documentacions. Sens dubte repetiré."}, "en-US": {"title": "Luis Aguilar", "content": "Spectacular real estate agency. Very professional, they give their all to their clients, and I had the wonderful opportunity to be advised by Anna Mª Palomas, who sold me two properties and I've never had a single problem. She's a true professional, quick to sell, and very reliable with documentation. I will definitely return."}}, {"es-ES": {"title": "Mabel Rodríguez Montilla", "content": "Anna Mª Palomas fue la agente que escogí para vender mi piso y ha sido un 10. Se entrega al 200%, es eficaz, profesional, atenta, conoce su oficio al dedillo, es de confianza, está disponible, resuelve, investiga. Me he sentido en buenas manos y muy bien asesorada de principio a fin, tanto para la valoración de la propiedad como para las gestiones necesarias y, sobre todo, un cierre de venta excelente. Seguro volveré a contar con su apoyo y experiencia en mi siguientes movimientos inmobiliarios. ¡Mil gracias!"}, "ca-ES": {"title": "Mabel Rodríguez Montilla", "content": "Anna Mª Palomas va ser l'agent que vaig escollir per vendre el meu pis i ha estat un 10. S'entrega al 200%, és eficaç, professional, atenta, coneix el seu ofici amb detall, és de confiança, està disponible, resol, investiga. M'he sentit en bones mans i molt ben assessorada des del principi fins al final, tant per a la valoració de la propietat com per a les gestions necessàries i, sobretot, un tancament de venda excel·lent. Segur tornaré a comptar amb el seu suport i experiència en els meus moviments immobiliaris següents. Mil gràcies!"}, "en-US": {"title": "Mabel Rodríguez Montilla", "content": "Anna Mª Palomas was the agent I chose to sell my apartment, and she was a 10/10. She gives 200%, is efficient, professional, attentive, knows her job inside out, is trustworthy, available, solves problems, and does her research. I felt in good hands and was very well advised from start to finish, both from the property valuation and the necessary paperwork, and, above all, the sale was excellent. I will definitely count on her support and expertise again for my next real estate move. Thank you so much!"}}], "videos": [{"url": "https://youtu.be/VcbDqGoiaAo"}], "slogan": {"es-ES": "“En este oficio, la confianza lo es todo.”", "ca-ES": "“En aquest ofici, la confiança ho és tot.”", "en-US": "“In this business, trust is everything.”"}, "aboutMe": {"es-ES": "Formada en Administración Comercial y con diversos cursos sobre gestión inmobiliaria a mis espaldas, llevo +6 años en el sector inmobiliario, los suficientes para saber que éste es un oficio de personas en el que la confianza lo es todo. Por eso, mi capacidad resolutiva, mi hablar alto y claro y una capacidad innata para conectar con la gente, son lo que más aprecian de mí mis clientes.\n\nSi algo me define es la decisión e intensidad con la que me enfrento a todo: mi familia y amigos, mi trabajo, mi tiempo libre... Este ímpetu hace que conserve un espíritu joven (ya lo querrían muchos millennials); nada de perder el tiempo, que no hay mucho.\n\nCuando no trabajo, me gusta mucho ir al cine, al teatro, bailar, viajar, nadar, leer, pasear... Y procuro hacerlo todo siempre bien acompañada y a tope.", "ca-ES": "Formada en Administració Comercial i amb diversos cursos sobre gestió immobiliària a la meva esquena, porto +6 anys al sector immobiliari, els suficients per saber que aquest és un ofici de persones en què la confiança ho és tot. Per això, la meva capacitat resolutiva, el meu parlar alt i clar i una capacitat innata per connectar amb la gent són el que més aprecien dels meus clients.\n\nSi alguna cosa em defineix és la decisió i intensitat amb què m'enfronto a tot: la meva família i amics, la meva feina, el meu temps lliure... Aquest ímpetu fa que conservi un esperit jove (ja ho voldrien molts millennials); res de perdre el temps, que no hi ha gaire.\n\nQuan no treballo, m'agrada molt anar al cinema, al teatre, ballar, viatjar, nedar, llegir, passejar... I procuro fer-ho tot sempre ben acompanyada i al màxim.", "en-US": "Trained in Commercial Administration and with various courses on real estate management behind me, I have been in the real estate sector for over 6 years, enough to know that this is a people's job in which trust is everything. That's why my problem-solving ability, my loud and clear speech and an innate ability to connect with people are what my clients appreciate most about me.\n\nIf anything defines me, it's the determination and intensity with which I face everything: my family and friends, my work, my free time... This impetus keeps me young in spirit (many millennials would like that); no wasting time, there isn't much of it.\n\nWhen I'm not working, I really like going to the cinema, the theatre, dancing, travelling, swimming, reading, walking... And I try to do everything always well accompanied and at full speed."}, "training": {"es-ES": "Administración Comercial | Gestión Inmobiliaria", "ca-ES": "Administració Comercial | Gestió immobiliària", "en-US": "Business Administration | Real Estate Management"}, "experience": {"es-ES": "+9 años en el sector inmobiliario", "ca-ES": "+9 anys al sector immobiliari", "en-US": "+9 years in the Real Estate sector"}, "ourSales": {"es-ES": "+62 ventas | +5 alquileres", "ca-ES": "+62 vendes | +5 lloguers", "en-US": "+62 sales | +5 rentals"}, "services": {"es-ES": "Venta | Alquiler", "ca-ES": "Venda | Lloguer", "en-US": "Sales | Rentals"}, "zones": {"es-ES": "Barcelona | Manresa", "ca-ES": "Barcelona | Manresa", "en-US": "Barcelona | Manresa"}, "agency": {"commercialBrand": "Anna Mª Palomas", "manager": false, "independent": true, "externalAgencyLogo": null, "logo": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agency_logo/CoBrand-Anna-Ma-Palomas-blanco-jpg-6342f946a6537.jpg", "slug": "anna-maria-palomas", "reviews": [{"title": "Begoña Harper", "content": "Súper contentos con la atención y gestión recibidas por parte de Anna Maria, muy profesional y atenta con los clientes, de hecho ya habíamos trabajado con ella anteriormente y lo seguiremos haciendo. Le doy 5 estrellas porque no hay más, ¡pero es de 10!"}, {"title": "Miguel Ángel Domínguez", "content": "Ha sido un placer trabajar con esta inmobiliaria, sobre todo con la asesora Anna Mª Palomas, que en todo momento estuvo asesorando para que la venta se realizara lo antes posible y en condiciones satisfactorias."}, {"title": "Alejandra Iglesias", "content": "Muy buena experiencia en la compra de un piso para la inversión, Anna Palomas un 10 en todo. Profesional, transparente y humana. Estoy contentísima con la inversión y con el trato. Gracias, Anna."}]}}}, {"reference": "AAM0007-543", "slug": "atico-con-terraza-en-el-quadrat-d'or-de-barcelona", "type": "rent", "status": "rented", "estateType": "flat", "address": {"visibility": "street", "point": {"latitude": 41.393398, "longitude": 2.1683001}, "streetType": "Calle", "streetName": "Roger de Llúria", "streetNumber": "51", "province": "Barcelona", "provinceSlug": "barcelona", "town": "Barcelona", "zone": "Dreta de l'Eixample", "zoneGroup": "Eixample"}, "price": 2400, "externalResources": [], "createdAt": "2022-06-30 17:34:51", "updatedAt": "2026-03-30 14:37:29", "cee": {"energyCertificateType": "completed", "energyCertificateRating": "G", "energyCertificateEmissionsRating": "G", "energyCertificateValue": null, "energyCertificateEmissionsValue": 87}, "propertyType": null, "features": ["terrace", "elevator", "chimney"], "areaConstructed": 161, "areaUsable": null, "areaPlot": null, "orientationNorth": null, "orientationSouth": true, "orientationEast": null, "orientationWest": true, "conservation": "good", "rooms": 2, "furnished": false, "floorsBuilding": 5, "bathroomNumber": 2, "conditionedAir": true, "penthouse": false, "language": {"code": "es-ES", "name": "Castellano"}, "emotionalTitle": {"es-ES": "El elegido", "ca-ES": "L'escollit", "en-US": "The chosen one"}, "emotionalDescription": {"es-ES": "Este ático no es apto para quienes buscan un piso estándar, ni para quienes se conforman con un lugar donde llegar del trabajo, cenar, ver Netflix y dormir hasta la hora de volver al trabajo.\nEste ático es perfecto para quienes quieren disfrutar del hogar al 100%. Para quienes saben apreciar los espacios singulares con mucha personalidad. Para quienes valoran las visitas y las cenas en buena compañía, ya sea en ese gran salón o en esa maravillosa terraza. Para quienes la ubicación en Barcelona importa. Este ático es tan especial que no se elige: te elige él a ti.", "ca-ES": "Aquest àtic no és apte per als que busquen un pis estàndard, ni per als que es conformen amb un lloc on arribar de la feina, sopar, veure Netflix i dormir fins a l'hora de tornar a la feina. Aquest àtic és perfecte per als qui volen gaudir de la llar al 100%. Per als qui saben apreciar els espais singulars amb molta personalitat. Per als que valoren les visites i els sopars en bona companyia, ja sigui en aquest gran saló o en aquesta meravellosa terrassa. Pels qui la ubicació a Barcelona importa. Aquest àtic és tan especial que no es tria: t'escull ell a tu.", "en-US": "This penthouse is not suitable for those looking for a standard apartment, nor for those who are satisfied with a place to get home from work, have dinner, watch Netflix and sleep until it is time to return to work. This penthouse is perfect for those who want to enjoy their home 100%. For those who know how to appreciate unique spaces with a lot of personality. For those who value visits and dinners in good company, whether in that large room or on that wonderful terrace. For whom location in Barcelona matters. This penthouse is so special that it is not chosen: it chooses you."}, "description": {"es-ES": "Ático con terraza de 2 habitaciones en el Quadrat d'Or de Barcelona", "ca-ES": "Àtic amb terrassa de 2 habitacions al Quadrat d'Or de Barcelona", "en-US": "2-bedroom penthouse with terrace in the Quadrat d'Or in Barcelona"}, "highlights": {"es-ES": "Piso en finca regia con ascensor.\nUbicado en la calle Roger de Llúria.\nSituado en una 5ª planta.\nBonitas vistas.\nEntrada de luz natural todo el día.\nOrientación suroeste.\nGran terraza de 35 m2, a la que se accede desde el salón.\nBuhardilla con estudio y suite.\nBaño completo y aseo con plato de ducha.\nCocina independiente equipada.\nCalefacción a gas natural y aire acondicionado por splits.\nCompletamente exterior.\nNo se admiten mascotas.", "ca-ES": "Pis a finca règia amb ascensor. Ubicat al carrer Roger de Llúria. Situat en una 5a planta. Boniques vistes. Entrada de llum natural tot el dia. Orientació sud-oest. Gran terrassa de 35 m2, on s'accedeix des del saló. Golfes amb estudi i suite. Bany complet i lavabo amb plat de dutxa. Cuina independent equipada. Calefacció de gas natural i aire condicionat per splits. Completament exterior. No s'admeten mascotes.", "en-US": "Apartment in a royal building with elevator. Located on Roger de Llúria street. Located on the 5th floor. Nice views. Entry of natural light all day. Southwest orientation. Large terrace of 35 m2, which is accessed from the living room. Attic with study and suite. Full bathroom and toilet with shower tray. Equipped independent kitchen. Natural gas heating and split air conditioning. Completely exterior. Pets are not allowed."}, "isSpecialFor": {"es-ES": "Fantástica ubicación en el Quadrat d'Or de l'Eixample dret de Barcelona.\nEstá perfectamente comunicado con metro L2 Passeig de Gràcia, L1 Urquinaona, con bus 7, 19, 47, V19, D50, H12.\nAdmite gran variedad de distribución y diseño.\nA tan solo cuatro minutos andando del Passeig de Gràcia.", "ca-ES": "Fantástica ubicación en el Quadrat d'Or de l'Eixample dret de Barcelona.\nEstá perfectamente comunicado con metro L2 Passeig de Gràcia, L1 Urquinaona, con bus 7, 19, 47, V19, D50, H12.\nAdmite gran variedad de distribución y diseño.\nA tan solo cuatro minutos andando del Passeig de Gràcia.", "en-US": "Fantastic location in the Quadrat d'Or in the right Eixample of Barcelona. It is perfectly connected with metro L2 Passeig de Gràcia, L1 Urquinaona, with bus 7, 19, 47, V19, D50, H12. Supports a wide variety of distribution and design. Just a four-minute walk from Passeig de Gràcia."}, "conditions": {"es-ES": " Imprescindible DNI o NIE.\n Honorarios y gestión de contrato: 10%+IVA de una anualidad.\n 1 mes de fianza y 1 ó 2 meses de garantía adicional, sujetos a la solvencia del inquilino.\n Disponibilidad inmediata.\n Contrato de 5 años con 1 año de obligado cumplimiento.\n Imprescindible acreditar solvencia económica.", "ca-ES": "Imprescindible DNI o NIE. Honoraris i gestió de contracte: 10% d'una anualitat. 1 mes de fiança i 1 o 2 mesos de garantia addicional, subjectes a la solvència de l'inquilí. Disponibilitat immediata. Contracte de 5 anys amb 1 any de compliment obligat. Imprescindible acreditar solvència econòmica.", "en-US": "DNI or NIE is essential. Fees and contract management: 10%+VAT of one annuity. 1 month deposit and 1 or 2 months additional guarantee, subject to the tenant's solvency. Immediate availability. 5-year contract with 1 year of mandatory compliance. It is essential to prove financial solvency."}, "metaTitle": {"es-ES": "Ático con terraza de 2 habitaciones en el Quadrat d'Or de Barcelona", "ca-ES": null, "en-US": null}, "metaDescription": {"es-ES": null, "ca-ES": null, "en-US": null}, "urlSlug": {"es-ES": "atico-con-terraza-en-el-quadrat-d'or-de-barcelona", "ca-ES": null, "en-US": null}, "basic": {"es-ES": null, "ca-ES": null, "en-US": null}, "agent": {"fullName": "Anna Mª Palomas", "commercialBrand": null, "email": "annam.palomas@monapart.com", "telNumber": "+34606321128", "telFullNumber": "+34606321128", "languages": ["Español", "Català"], "socialNetworks": {"instagram": "https://www.instagram.com/annam.palomas/", "linkedIn": "https://www.linkedin.com/in/anna-m%C2%AA-palomas-pons-78236b14b/", "facebook": "https://www.facebook.com/annam.palomas"}, "slug": "annam-palomas", "display": true, "avatar": {"url": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_avatar/Anna-M-Palomas-web-jpeg-62d7e766becf2.jpg", "dimensions": {"160": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/160/agent_avata