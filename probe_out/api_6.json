onaws.com/monapart.felix-resized/800/agent_highlight/Montse-Pla-landing-png-62ddb57db0abf.png", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_highlight/Montse-Pla-landing-png-62ddb57db0abf.png", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_highlight/Montse-Pla-landing-png-62ddb57db0abf.png"}}, "relatedImage": {"url": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "dimensions": {"160": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/160/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "420": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/420/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "600": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/600/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "800": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/800/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "1400": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1400/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg", "1920": "https://s3.eu-west-1.amazonaws.com/monapart.felix-resized/1920/agent_avatar/MP-and-PB-63-jpg-62ddb5e4834c4.jpg"}}, "certifications": null, "googleValorationLink": "https://share.google/j4KZdr5HNqigJCTk3", "googleValorationImage": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agent_googleValorationImage/Topo-Google-5-png-6aa02af1c9dd0.png", "reviews": [{"es-ES": {"title": "Moisés Jordi Pinatella", "content": "Muy bien atendidos por Montse Pla de 16th Floor en un doble proceso de compra y venta. Gran profesional."}, "ca-ES": {"title": "Moisès Jordi Pinatella", "content": "Molt ben atesos per la Montse Pla de 16th Floor en un doble procés de compra i venda. Gran professional."}, "en-US": {"title": "Moses Jordi Pinatella", "content": "Very well attended by the Montse Pla de 16th Floor in a double process of purchase and sale. Great professional."}}, {"es-ES": {"title": "Natalia F.", "content": "Una gran empresa, profesionales de verdad. En nuestro caso fue Montse quien nos atendió en todo el proceso. Sin lugar a dudas, será mi primera opción si tengo que hacer cualquier otro trámite."}, "ca-ES": {"title": "Natàlia F.", "content": "Una gran empresa, professionals de debò. En el nostre cas va ser la Montse qui ens va atendre en tot el procés. Sense cap dubte, serà la meva primera opció si he de fer qualsevol altre tràmit."}, "en-US": {"title": "Natalia F.", "content": "A great company, true professionals. In our case, it was Montse who assisted us throughout the entire process. Without a doubt, she will be my first choice if I have to do any other procedure."}}, {"es-ES": {"title": "Luisa Germán", "content": "Contraté sus servicios para vender mi piso y el acompañamiento ha sido excepcional. Cuando las personas disfrutan con su trabajo y son profesionales, transmiten un entusiasmo y un servicio adicional que no tiene precio y marca la diferencia. Recomiendo muchísimo a todo el que necesite una agencia inmobiliaria en Barcelona. Súper agradecida."}, "ca-ES": {"title": "Luisa Germán", "content": "Vaig contractar els seus serveis per vendre el meu pis i l'acompanyament ha estat excepcional. Quan les persones gaudeixen amb la seva feina i són professionals, transmeten un entusiasme i un servei addicional que no té preu i marca la diferència. Recomano moltíssim a tothom que necessiti una agència immobiliària a Barcelona. Súper agraïda."}, "en-US": {"title": "Luisa Germán", "content": "I hired their services to sell my apartment, and their support has been exceptional. When people enjoy their work and are professional, they convey an enthusiasm and an extra level of service that is priceless and makes all the difference. I highly recommend them to anyone needing a real estate agency in Barcelona. I'm incredibly grateful."}}, {"es-ES": {"title": "Sandra Guijosa", "content": "Genial. He trabajado con ellas para vender mi piso. Ha sido un placer trabajar tan bien, siempre acompañada y bien asesorada. Estoy encantada."}, "ca-ES": {"title": "Sandra Guijosa", "content": "Genial. He treballat amb elles per vendre el meu pis. Ha estat un plaer treballar tan bé, sempre acompanyada i ben assessorada. Estic encantada."}, "en-US": {"title": "Sandra Guijosa", "content": "Fantastic! I worked with them to sell my apartment. It was a pleasure working with them; they were always supportive and gave me great advice. I'm delighted."}}], "videos": [], "slogan": {"es-ES": "\"Me gusta ser yo misma en el trabajo, la confianza y la transparencia son mis mayores aliados y hasta ahora siempre me han dado buen resultado.\"", "ca-ES": "\"M'agrada ser jo mateixa a la feina. La confiança i la transparència són els meus majors aliats i fins ara sempre m'han donat bon resultat.\"", "en-US": "\"I like to be myself at work. Trust and transparency are my greatest allies and so far they have always given me good results.\""}, "aboutMe": {"es-ES": "Si no fuera arquitecta, seguramente me dedicaría a alguna de mis dos pasiones: los zapatos o el bricolaje. Es una combinación muy rara, ¿verdad? Para la primera tenemos una explicación: Desde que vi \"El mago de Oz\" nunca he dejado de soñar en los chapines colorados.\n\nMi pelo rizado y pelirrojo, mis pecas y mis vivarachos ojos verdes combinan a la perfección con mi personalidad, viva, alegre, intrépida, decidida. Quienes me conocen bien, me llaman Mons y saben que siempre estoy de buen humor, sobre todo en los días de lluvia con una buena novela negra entre manos o viendo Downton Abbey.", "ca-ES": "Si no fos arquitecta, segurament em dedicaria a alguna de les meves dues passions: les sabates o el bricolatge. És una combinació molt rara, oi? Per a la primera tenim una explicació: Des que vaig veure \"El mag d'Oz\" mai he deixat de somiar als xapins vermells.\n\nEls meus cabells arrissats i pèl-roig, les meves pigues i els meus gafarrons ulls verds combinen a la perfecció amb la meva personalitat, viva, alegre, intrèpida, decidida. Els que em coneixen bé, em diuen Mons i saben que sempre estic de bon humor, sobretot els dies de pluja amb una bona novel·la negra entre mans o veient Downton Abbey.", "en-US": "If I weren't an architect, I would surely devote myself to one of my two passions: shoes or DIY. It's a very strange combination, isn't it? For the first one we have an explanation: Since I saw \"The Wizard of Oz\" I have never stopped dreaming about red slippers.\n\nMy curly red hair, my freckles and my lively green eyes combine perfectly with my personality: lively, cheerful, intrepid, determined. Those who know me well call me Mons and know that I am always in a good mood, especially on rainy days with a good crime novel in hand or watching Downton Abbey."}, "training": {"es-ES": "Arquitectura", "ca-ES": "Arquitectura", "en-US": "Architecture"}, "experience": {"es-ES": "+12 años en el sector inmobiliario", "ca-ES": "+12 anys al sector immobiliari", "en-US": "+12 years in the Real Estate sector"}, "ourSales": {"es-ES": "+150 ventas", "ca-ES": "+150 vendes", "en-US": "+150 sales"}, "services": {"es-ES": "Venta | Alquiler", "ca-ES": "Venda | Lloguer", "en-US": "Sales | Rentals"}, "zones": {"es-ES": "Barcelona", "ca-ES": "Barcelona", "en-US": "Barcelona"}, "agency": {"commercialBrand": "16th Floor", "manager": true, "independent": false, "externalAgencyLogo": null, "logo": "https://s3.eu-west-1.amazonaws.com/monapart.felix/agency_logo/CoBrand-16-floor-Mesa-de-trabajo-1-01-jpg-645b50a1b94a4.jpg", "slug": "16th-floor", "reviews": [{"title": "Natalia F.", "content": "Profesionales de verdad. Sin lugar a dudas serán mi primera opción si las necesito de nuevo."}, {"title": "Moisés Jordi Pinatella", "content": "Muy bien atendidos en un doble proceso de compra y venta."}, {"title": "Sandra Guijosa", "content": "Genial. He trabajado con ellas para vender mi piso. Ha sido un placer trabajar tan bien, siempre acompañada y bien asesorada. Estoy encantada."}, {"title": "Julia", "content": "Mi experiencia con Patricia de 16th Floor ha sido extraordinaria. El trato desde el primer día ha sido cercano y profesional. Me he sentido muy acompañada en todo momento en el proceso de compra. Es una persona que responde a llamadas y whatsapps en todo momento, aporta soluciones a todas las dudas técnicas y del mundo bancario e inmobiliario, y que tiene un enfoque muy humano y con mucha empatía. A su lado y al de su socia y equipo sabes que su única intención es que todo vaya bien, en beneficio de ambas partes, con total transparencia y honestidad. ¡He tenido mucha suerte de cruzarme con este equipo! ¡Gracias!"}, {"title": "Xavier Vigas", "content": "Muy profesionales, facilitadoras y defendiendo en todo momento nuestros intereses. Un acierto contratar con ellas la gestión de la venta del piso."}]}}}, {"reference": "MP0004-6140", "slug": "piso-de-alquiler-temporal-en-sant-boi-de-llobregat-con-4-habitaciones-terraza-parquing-y-espectacular-zona-comunitaria-barcelona", "type": "rent", "status": "rented", "estateType": "flat", "address": {"visibility": "street", "point": {"latitude": 41.3426661, "longitude": 2.0296778}, "streetType": "Pasaje", "streetName": "Pallerols", "streetNumber": "8", "province": "Barcelona", "provinceSlug": "barcelona", "town": "Sant Boi de Llobregat", "zone": "", "zoneGroup": ""}, "price": 2700, "externalResources": [{"url": "https://youtu.be/4_CY8gDMbRs", "description": "MP0004-6140", "type": "video"}], "createdAt": "2026-02-18 15:29:35", "updatedAt": "2026-05-15 09:45:31", "cee": {"energyCertificateType": "completed", "energyCertificateRating": "A", "energyCertificateEmissionsRating": "A", "energyCertificateValue": 23, "energyCertificateEmissionsValue": 4}, "propertyType": "flat", "features": ["terrace", "parking", "elevator", "swimming_pool", "garden", "doorman", "handicap_adapted_access", "handicap_adapted_use", "community_zone"], "areaConstructed": 116, "areaUsable": 98, "areaPlot": null, "orientationNorth": null, "orientationSouth": true, "orientationEast": null, "orientationWest": true, "conservation": "new", "rooms": 4, "furnished": true, "floorsBuilding": 8, "bathroomNumber": 2, "conditionedAir": true, "penthouse": false, "emotionalTitle": {"es-ES": "Tu mundo y sus satélites", "ca-ES": "El teu món i els seus satèl·lits", "en-US": "Your world and its satellites"}, "emotionalDescription": {"es-ES": "Tu piso debería ser tu mundo, esté donde esté, durante el tiempo que vivas allí. Debería ser ese lugar seguro y tranquilo al que regresas al final de la jornada, donde compartir buenos momentos con la gente que quieres. Pero tu vida no es solo comer y dormir. Por eso, tu mundo es más mundo cuando tiene unos satélites alrededor que lo hacen más disfrutable. Por ejemplo, una piscina, zona de coworking, gimnasio, o incluso tu propia terraza. Es decir, como este nuevísimo piso: un mundo rodeado de satélites, un mundo más mundo para que tu vida sea más vida.", "ca-ES": "El teu pis hauria de ser el teu món, sigui on sigui, durant el temps que hi visquis. Hauria de ser aquell lloc segur i tranquil on tornes al final de la jornada, on compartir bons moments amb la gent que vols. Però la teva vida no és només menjar i dormir. Per això, el teu món és més món quan té uns satèl·lits al voltant que el fan més gaudible. Per exemple, una piscina, zona de coworking, gimnàs, o fins i tot la teva terrassa. És a dir, com aquest nou pis: un món envoltat de satèl·lits, un món més món perquè la teva vida sigui més vida.", "en-US": "Your apartment should be your world, wherever it is, for as long as you live there. It should be that safe and peaceful place you return to at the end of the day, where you share good times with the people you love. But your life isn't just about eating and sleeping. That's why your world is more complete when it has amenities that make it more enjoyable. For example, a swimming pool, a coworking space, a gym, or even your own terrace. In other words, like this brand-new apartment: a world surrounded by amenities, a world made even better so that your life is truly fulfilling."}, "description": {"es-ES": "Piso de alquiler de vivienda habitual en Sant Boi de Llobregat con 4 habitaciones, terraza, parquing y espectacular zona comunitaria, Barcelona", "ca-ES": "Pis de lloguer d´habitatge habitual a Sant Boi de Llobregat amb 4 habitacions, terrassa, pàrquing i espectacular zona comunitària, Barcelona", "en-US": "Apartment for rent in Sant Boi de Llobregat, Barcelona, with 4 bedrooms, terrace, parking and spectacular communal area"}, "highlights": {"es-ES": "Piso de alquiler de vivienda habitual en Sant Boi de Llobregat, Barcelona, con 4 habitaciones, terraza, parking y espectacular zona comunitaria.\nEs un piso esquinero, recién decorado y con todo el mobiliario a estrenar.\nSe ubica en una 4ª planta real con dos ascensores en un edificio construido en el 2025.\nEl piso tiene incluida una plaza de parking.\nTodo el piso es exterior y orientado a Suroeste, con salida a la terraza de 55 m² desde todas las estancias.\nSalón-comedor-cocina integrados en una amplia zona, con luz y sol por todos lados por ser esquinero. \nLa cocina, de líneas rectas y modernas, tiene una isla con taburetes. Equipada con placa de inducción y todos los electrodomésticos Balay integrados (nevera, lavavajillas, aerotermia, campana, horno y microondas).\nCuenta con 4 habitaciones: tres individuales y una doble, todas ellas con salida a la enorme terraza. \nHay 2 baños, uno dentro de la suite y otro para el resto de las habitaciones, ambos con ducha y perfectamente amueblados y equipados.\nEn la sala tiene un trastero reservado para la lavadora-secadora y todos los utensilios de limpieza. \nLa terraza está completamente equipada con mesa con sombrilla, zona de estar con sofás y hamacas.\nSuelo de parquet en toda la vivienda incluidos baños y cocina. Gres porcelánico de color gris en la terraza. \nCarpinterías de color oscuro con puente térmico y doble cristal.\nClimatización por aerotermia por conductos regulada por un termostato.\nInstalación en toda la casa de ethernet y antena de TV.", "ca-ES": "Pis de lloguer d´habitatge habitual a Sant Boi de Llobregat, Barcelona, amb 4 habitacions, terrassa, pàrquing i espectacular zona comunitària.\nÉs un pis cantoner, acabat de decorar i amb tot el mobiliari a estrenar.\nS'ubica en una 4a planta reial amb dos ascensors en un edifici construït el 2025.\nEl pis té inclosa una plaça de pàrquing.\nTot el pis és exterior i orientat a Sud-oest, amb sortida a la terrassa de 55 m² des de totes les estances.\nSaló-menjador-cuina integrats en una àmplia zona, amb llum i sol per tot arreu per ser cantoner.\nLa cuina, de línies rectes i modernes, té una illa amb tamborets. Equipada amb placa d´inducció i tots els electrodomèstics Balay integrats (nevera, rentavaixelles, aerotèrmia, campana, forn i microones).\nCompte amb 4 habitacions: tres individuals i una doble, totes elles amb sortida a l'enorme terrassa.\nHi ha 2 banys, un dins de la suite i un altre per a la resta de les habitacions, tots dos amb dutxa i perfectament moblats i equipats.\nA la sala té un traster reservat per a la rentadora-assecadora i tots els utensilis de neteja.\nLa terrassa està completament equipada amb taula amb para-sol, zona d´estar amb sofàs i gandules.\nSòl de parquet a tot l'habitatge inclosos banys i cuina. Gres porcelànic de color gris a la terrassa.\nFusteries de color fosc amb pont tèrmic i doble vidre.\nClimatització per aerotèrmia per conductes regulada per un termòstat.\nInstal·lació a tota la casa d'ethernet i antena de TV.", "en-US": "Apartment for rent as a permanent residence in Sant Boi de Llobregat, Barcelona, with 4 bedrooms, terrace, parking and spectacular communal area.\nIt's a corner apartment, newly decorated and with all brand new furniture.\nIt is located on the 4th floor with two elevators in a building constructed in 2025.\nThe apartment includes a parking space.\nThe entire apartment is exterior and southwest oriented, with access to the 55 m² terrace from all rooms.\nLiving room-dining room-kitchen integrated into a large area, with light and sun from all sides due to being a corner unit.\nThe kitchen, with its clean, modern lines, features an island with stools. It is equipped with an induction hob and all integrated Balay appliances (refrigerator, dishwasher, air source heat pump, extractor hood, oven, and microwave).\nIt has 4 bedrooms: three single and one double, all with access to the huge terrace.\nThere are 2 bathrooms, one inside the suite and another for the rest of the rooms, both with showers and perfectly furnished and equipped.\nIn the living room there is a storage room reserved for the washer-dryer and all the cleaning supplies.\nThe terrace is fully equipped with a table with a parasol, a seating area with sofas and hammocks.\nParquet flooring throughout the entire property, including bathrooms and kitchen. Grey porcelain tiles on the terrace.\nDark-colored joinery with thermal break and double glazing.\nAir conditioning by ducts regulated by a thermostat.\nWhole house installation of Ethernet and TV antenna."}, "isSpecialFor": {"es-ES": "Está completamente equipado para instalarse con todas las comodidades.\nEl edificio, de última generación, cuenta con todo tipo de servicios: piscina, zona infantil, espacio de coworking, gimnasio con máquinas, espacios para ocio, mesa de ping-pong, servicio de entrega de pedidos, pista de pickleball…\nEl piso dispone de una plaza de parquing, amplia y cómoda, cerca de los ascensores.\nAl lado del parque de la Muntanyeta, donde se ubica la biblioteca Jordi Rubió i Balaguer, un complejo deportivo, la piscina municipal de la Muntanyeta y el Estadio Joan Baptista Milà Fc Santboià.\nPerfectamente comunicado con transporte público: buses L72, L70, L74, L78 y L96 y a 20 minutos de la estación de tren.\nCon fácil conexión a la Ronda de Dalt a Barcelona y a 10 minutos en coche del aeropuerto.", "ca-ES": "Està completament equipat per instal·lar-se amb totes les comoditats.\nL´edifici, d´última generació, compta amb tot tipus de serveis: piscina, zona infantil, espai de coworking, gimnàs amb màquines, espais per a lleure, taula de ping-pong, servei de lliurament de comandes, pista de pickleball…\nEl pis disposa d´una plaça de pàrquing, àmplia i còmoda, a prop dels ascensors.\nAl costat del parc de la Muntanyeta, on hi ha la biblioteca Jordi Rubió i Balaguer, un complex esportiu, la piscina municipal de la Muntanyeta i l'Estadi Joan Baptista Milà Fc Santboià.\nPerfectament comunicat amb transport públic: busos L72, L70, L74, L78 i L96 ia 20 minuts de l'estació de tren.\nAmb fàcil connexió a la Ronda de Dalt a Barcelona ia 10 minuts amb cotxe de l'aeroport.", "en-US": "It is fully equipped to be installed with all the comforts.\nThe state-of-the-art building has all kinds of amenities: swimming pool, children's area, coworking space, gym with machines, leisure areas, ping-pong table, order delivery service, pickleball court…\nThe apartment has a spacious and convenient parking space near the elevators.\nNext to the Muntanyeta park, where the Jordi Rubió i Balaguer library, a sports complex, the Muntanyeta municipal swimming pool and the Joan Baptista Milà FC Santboià Stadium are located.\nPerfectly connected by public transport: buses L72, L70, L74, L78 and L96 and 20 minutes from the train station.\nWith easy access to the Ronda de Dalt ring road to Barcelona and 10 minutes by car from the airport."}, "conditions": {"es-ES": "Alquiler de vivienda habitual: Contrato de duración de 5 años, con 1 año de obligado cumplimiento.\nRenta: 2.700 €.\nDisponibilidad inmediata.\nCondiciones de entrada: 1 mes de fianza, 1 mes de garantía adicional y renta del mes en curso.\nEl precio incluye los gastos repercutibles de IBI (5,24 €/mes) y comunidad (121 €/mes).\nITP: 1 % de la garantía adicional a cargo del inquilino.\nLos honorarios de agencia correrán a cargo del arrendador (Propietario).\nMascotas: Se estudiará cada caso en concreto.\nImprescindible acreditar solvencia económica (nóminas, declaraciones fiscales, avales o similar. En el caso de no tener ingresos en España, se solicitará otro tipo de información y garantías adicionales).\nRango de valores del alquiler de vivienda: \n-la vivienda se encuentra en zona de mercado tensionado\n-es obra nueva (menos de 5 años de antigüedad)\n-el sistema Estatal de Referencia de Precios de Alquiler de Vivienda no ofrece un valor aplicable para las viviendas de estas características.\n-la renta será la que pacten libremente entre las partes\nLa propiedad no es gran tenedor\nReferencia Certificado: VLNXD7YP6\nCédula de habitabilidad: CHB02515625049", "ca-ES": "Lloguer d'habitatge habitual: Contracte de durada de 5 anys, amb 1 any de compliment obligat.\nRenda: 2.700 €.\nDisponibilitat immediata.\nCondicions d´entrada: 1 mes de fiança, 1 mes de garantia addicional i renda del mes en curs.\nEl preu inclou les despeses repercutibles d'IBI (5,24 €/mes) i la comunitat (121 €/mes).\nITP: 1% de la garantia addicional a càrrec de l'inquilí.\nEls honoraris d'agència són a càrrec de l'arrendador (Propietari).\nMascotes: Sestudiarà cada cas en concret.\nImprescindible acreditar solvència econòmica (nòmines, declaracions fiscals, avals o similar. En cas de no tenir ingressos a Espanya, se sol·licitarà un altre tipus d'informació i garanties addicionals).\nRang de valors del lloguer d'habitatge:\n-l'habitatge es troba a zona de mercat tensionat\n-és obra nova (menys de 5 anys d'antiguitat)\n-el sistema estatal de referència de preus de lloguer d'habitatge no ofereix un valor aplicable per als habitatges d'aquestes característiques.\n-la renda serà la que pactin lliurement entre les parts\nLa propietat no és gran forquilla\nReferència Certificat: VLNXD7YP6\nCédula d'habitabilitat: CHB02515625049", "en-US": "Rental of main residence: Contract duration of 5 years, with 1 year of mandatory compliance.\nRent: €2,700.\nImmediate availability.\nEntry conditions: 1 month deposit, 1 additional month guarantee and rent for the current month.\nThe price includes the reimbursable expenses of IBI (€5.24/month) and community (€121/month).\nITP: 1% of the additional guarantee payable by the tenant.\nThe agency fees will be borne by the landlord (owner).\nPets: Each case will be studied individually.\nProof of financial solvency is required (pay stubs, tax returns, guarantees or similar). If you have no income in Spain, other information and additional guarantees will be requested.\nHousing rental price range:\n-The property is located in a tight market area\n-It is a new construction (less than 5 years old)\n-The State Housing Rental Price Reference System does not offer an applicable value for homes with these characteristics.\n-The rent will be that freely agreed upon by the parties\nThe property is not a large holding company.\nCertificate Reference: VLNXD7YP6\nCertificate of occupancy: CHB02515625049"}, "metaTitle": {"es-ES": "Piso de alquiler en Sant Boi de Llobregat, Barcelona", "ca-ES": "Pis de lloguer a Sant Boi de Llobregat, Barcelona", "en-US": "Rental apartment in Sant Boi de Llobregat, Barcelona"}, "metaDescription": {"es-ES": "Piso a estrenar de 116 m² con 4 habitaciones, terraza, piscina, jardín y parking. Incluye ascensor, aerotermia, aire por conductos y acceso adaptado.", "ca-ES": "Pis a estrenar de 116 m² amb 4 habitacions, terrassa, piscina, jardí i pàrquing. Amb ascensor, aerotèrmia, aire conduït i accés adaptat.", "en-US": "Brand-new 116 m² apartment with 4 bedrooms, terrace, pool, garden and parking. Includes elevator, ducted A/C, aerothermal heating and adapted access."}, "urlSlug": {"es-ES": "alquiler-piso-sant-boi-de-llobregat-terraza-piscina", "ca-ES": "lloguer-pis-sant-boi-de-llobregat-terraza-piscina", "en-US": "rent-apartment-sant-boi-de-llobregat-terrace-pool"}, "basic": {"es-ES": null, "ca-ES": null, "en-US": null}, "agent": {"fullName": "Patricia Bruno", "com