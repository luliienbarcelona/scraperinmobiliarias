naws.com\/monapart.felix-resized\/1920\/agent_avatar\/JAlv-22-jpg-62dcedb402796.jpg"}},"certifications":[{"id":"API","title":"API (Agente de la Propiedad Inmobiliaria)","alt":{"es":"Logo de API, Agente de la Propiedad Inmobiliaria","ca":"Logo d'API, Agent de la Propietat Immobili\u00e0ria","en":"Logo of API, Real Estate Agent"},"link":"https:\/\/www.api.cat","schema":{"name":"API","prop":"award","content":"Agente de la Propiedad Inmobiliaria Certificado"}},{"id":"CRS","title":"CRS (Certified Residential Specialist)","alt":{"es":"Logo de CRS, Especialista Residencial Certificado","ca":"Logo de CRS, Especialista Residencial Certificat","en":"Logo of CRS, Certified Residential Specialist"},"link":"https:\/\/www.crs.com","schema":{"name":"CRS","prop":"award","content":"Certified Residential Specialist"}}],"googleValorationLink":"https:\/\/share.google\/TU3lcdbCsRGjSrpVs","googleValorationImage":"https:\/\/s3.eu-west-1.amazonaws.com\/monapart.felix\/agent_googleValorationImage\/Topo-Google-5-png-6986214714d15.png","reviews":[{"es-ES":{"title":"Flavio Fagnani","content":"Realic\u00e9 la gesti\u00f3n del alquiler de un piso con ellos y todo sali\u00f3 excelente. Buena predisposici\u00f3n para todas mis solicitudes y dudas. Javier fue el agente que me acompa\u00f1\u00f3 durante toda la gesti\u00f3n, lo recomiendo 100%. Amable y de confianza."},"ca-ES":{"title":"Flavi Fagnani","content":"Vaig fer la gesti\u00f3 del lloguer d'un pis amb ells i tot va sortir excel\u00b7lent. Bona predisposici\u00f3 per a totes les meves sol\u00b7licituds i dubtes. Javier va ser l'agent que em va acompanyar durant tota la gesti\u00f3, ho recomano 100%. Amable i de confian\u00e7a."},"en-US":{"title":"Flavio Fagnani","content":"I managed the rental of an apartment with them and everything went perfectly. Good disposition for all my requests and doubts. Javier was the agent who accompanied me throughout the process, I recommend him 100%. Friendly and trustworthy."}},{"es-ES":{"title":"Nicole Pereyra Bonija","content":"Muy contenta de cambiarnos de piso gracias a Javier \u00c1lvarez. \u00a1Un trato de 10!"},"ca-ES":{"title":"Nicole Pereyra Bonija","content":"Molt contenta de canviar-nos de pis gr\u00e0cies a Javier \u00c1lvarez. Un tracte de 10!"},"en-US":{"title":"Nicole Pereyra Bonija","content":"Very happy to move into a new apartment thanks to Javier \u00c1lvarez. A 10\/10 deal!"}},{"es-ES":{"title":"Guillem Quetglas","content":"Agencia muy recomendable. Atentos, serviciales y dispuestos a ayudar y encontrar soluciones. Javier \u00c1lvarez, un 10."},"ca-ES":{"title":"Guillem Quetglas","content":"Ag\u00e8ncia molt recomanable. Atents, servicials i disposats a ajudar i trobar solucions. Javier \u00c1lvarez, un 10"},"en-US":{"title":"Guillem Quetglas","content":"Highly recommended agency. Attentive, helpful and willing to help and find solutions. Javier \u00c1lvarez, a 10."}},{"es-ES":{"title":"Geral Th","content":"Queremos destacar la atenci\u00f3n de Javier, asesor asociado a Monapart, que en todo momento se ha implicado en nuestras necesidades a la hora de encontrar piso. En todo momento se puede apreciar su buena atenci\u00f3n y profesionalidad. \u00a1Gracias por ayudarnos a encontrar nuestro nuevo hogar! De Margarita, Geraldine y Camila. :)"},"ca-ES":{"title":"Geral Th","content":"Volem destacar l\u00b4atenci\u00f3 de Javier, assessor associat a Monapart, que en tot moment s\u00b4ha implicat en les nostres necessitats al\u00b4hora de trobar pis. En tot moment es pot apreciar la bona atenci\u00f3 i professionalitat. Gr\u00e0cies per ajudar-nos a trobar la nostra nova llar! De Margarida, Geraldine i Camil\u00b7la. :)"},"en-US":{"title":"Geral Th","content":"We would like to highlight the attention of Javier, an associate consultant at Monapart, who has always been involved in our needs when it came to finding an apartment. His good attention and professionalism can be appreciated at all times. Thank you for helping us find our new home! From Margarita, Geraldine and Camila. :)"}}],"videos":[{"url":"https:\/\/youtu.be\/2sj6jdKAwEI"}],"slogan":{"es-ES":"\"Me gusta tener el trabajo al d\u00eda y no me importa el horario. \u00a1Las necesidades de mis clientes son lo importante!\"","ca-ES":"\"M'agrada tenir la feina al dia i no m'importa l'horari. Les necessitats dels meus clients s\u00f3n el m\u00e9s important!\"","en-US":"\"I like to keep up with my work schedule and I don't care about the schedule. My clients' needs are what matters!\""},"aboutMe":{"es-ES":"Tengo una amplia formaci\u00f3n en ciencias empresariales y en gesti\u00f3n inmobiliaria y de la construcci\u00f3n, me encanta aprender y no he dejado de hacerlo. A esta amplia formaci\u00f3n, s\u00famale m\u00e1s de 40 a\u00f1os de experiencia en el sector inmobiliario, acompa\u00f1ando a mis clientes en el proceso de venta de su casa, un viaje apasionante que, a veces, puede resultar complicado. Yo hago que no lo sea.\n\nEn Domestics, soy responsable del departamento de alquileres, una de las \u00e1reas m\u00e1s tensionadas en Barcelona. Mi templanza y buen hacer son claves para gestionar con \u00e9xito una transacci\u00f3n que requiere precisi\u00f3n y mucha paciencia. \n\nMe gusta tener el trabajo al d\u00eda y no me importa el horario. \u00a1Las necesidades de los clientes son lo importante! Y s\u00ed, de nuevo, a pesar de llevar muchos a\u00f1os en este sector, sigo aprendiendo cada d\u00eda.","ca-ES":"Tinc una \u00e0mplia formaci\u00f3 en ci\u00e8ncies empresarials i en gesti\u00f3 immobili\u00e0ria i de la construcci\u00f3, m'encanta aprendre i no he deixat de fer-ho. A aquesta \u00e0mplia formaci\u00f3, suma-li m\u00e9s de 40 anys d'experi\u00e8ncia al sector immobiliari, acompanyant els meus clients en el proc\u00e9s de venda de casa, un viatge apassionant que, de vegades, pot resultar complicat. Jo faig que no ho sigui.\n\nA Domestics, s\u00f3c responsable del departament de lloguers, una de les \u00e0rees m\u00e9s tensionades a Barcelona. La meva tempran\u00e7a i bon fer s\u00f3n claus per gestionar amb \u00e8xit una transacci\u00f3 que requereix precisi\u00f3 i molta paci\u00e8ncia. \n\nM'agrada tenir la feina al dia i no m'importa l'horari. Les necessitats dels clients s\u00f3n el m\u00e9s important! I s\u00ed, de nou, tot i que fa molts anys que est\u00e0 en aquest sector, segueixo aprenent cada dia.","en-US":"I have a broad background in business sciences and real estate and construction management, I love learning and I have not stopped doing so. Add to this extensive training more than 40 years of experience in the real estate sector, accompanying my clients in the process of selling their home, an exciting journey that can sometimes be complicated. I make it not so.\n\nAt Domestics, I am responsible for the rental department, one of the most stressed areas in Barcelona. My composure and good work are key to successfully managing a transaction that requires precision and a lot of patience. \n\nI like to keep up with work and I don't care about the schedule. The needs of the clients are what is important! And yes, again, despite having been in this sector for many years, I continue to learn every day."},"training":{"es-ES":"Ciencias Empresariales | Estudios Inmobiliarios y de la Construcci\u00f3n | MBA | PADE IESE","ca-ES":"Ci\u00e8ncies Empresarials | Estudis Immobiliaris i de la Construcci\u00f3 | MBA | PADE IESE","en-US":"Business Studies | Real Estate and Construction Studies | MBA | PADE IESE"},"experience":{"es-ES":"+40 a\u00f1os en el sector inmobiliario","ca-ES":"+40 anys al sector immobiliari","en-US":"+40 years in the real estate sector"},"ourSales":{"es-ES":null,"ca-ES":null,"en-US":null},"services":{"es-ES":"Venta | Alquiler","ca-ES":"Venda | Lloguer","en-US":"Sales | Rentals"},"zones":{"es-ES":"Barcelona","ca-ES":"Barcelona","en-US":"Barcelona"},"agency":{"commercialBrand":"Domestics","manager":true,"independent":false,"externalAgencyLogo":null,"logo":"https:\/\/s3.eu-west-1.amazonaws.com\/monapa